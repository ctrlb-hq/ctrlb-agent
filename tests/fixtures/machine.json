{
  "about": "The hooks protocol (docs/relay-hooks.md, The agent-side state machine): one case per row of the table, and the failure cases. Each step runs one hook (claude: plugin/hooks/hook.py, codex: codex/hook.py) against a scripted fake Seeker that records the calls. answers maps a route (claims, check, done, handoffs, artifacts) to answers used in order (the last repeats); an answer is {status?, body?, sleep?}. A string \"{now+N}\" becomes now plus N seconds in µs. expect: calls (the claims, check, done and handoffs calls in order, each [method, route, a subset of its body]), context_has and context_not (the injected text or deny reason), decision (deny or none), state (a subset of the state file after; tasks and holds compared by their keys). Synthetic: built by hand from the Seeker routes in docs/relay.md, not recorded.",
  "defs": {
    "task1": {"held": true, "resource": "task 01 parse", "key": "name:task 01 parse", "paths": ["path:src/parse.py"], "token": "tok-1", "lease_until": "{now+1800}", "test": "python3 -m unittest tests/test_parse.py", "ask_about": ["the date format"],
              "next_task": {"name": "task 01 parse", "key": "name:task 01 parse", "brief": "Implement parse.", "paths": ["path:src/parse.py"], "test": "python3 -m unittest tests/test_parse.py", "ask_about": ["the date format"]}},
    "task2": {"held": true, "resource": "task 02 emit", "key": "name:task 02 emit", "paths": ["path:src/emit.py"], "token": "tok-2", "lease_until": "{now+1800}", "test": "python3 -m unittest tests/test_emit.py",
              "next_task": {"name": "task 02 emit", "key": "name:task 02 emit", "brief": "Implement emit.", "paths": ["path:src/emit.py"], "test": "python3 -m unittest tests/test_emit.py"}},
    "none_free": {"held": false, "free_tasks": [], "message": "There is no free task in this run: post a note saying you have no task and stop"},
    "holding1": {"agent": "agent-1", "run": "run-m", "state": "holding", "pending_done": null, "calls": {"claim": 1, "check": 0, "done": 0, "read": 0},
                 "tasks": {"task 01 parse": {"name": "task 01 parse", "key": "name:task 01 parse", "paths": ["path:src/parse.py"], "test": "python3 -m unittest tests/test_parse.py", "ask_about": [], "lease_until": "{now+1700}", "lease_s": 1800}},
                 "holds": {"name:task 01 parse": {"resource": "task 01 parse", "task": "task 01 parse", "lease_until": "{now+1700}", "lease_s": 1800},
                           "path:src/parse.py": {"resource": "task 01 parse", "task": "task 01 parse", "lease_until": "{now+1700}", "lease_s": 1800}}},
    "holding1_near": {"agent": "agent-1", "run": "run-m", "state": "holding", "pending_done": null, "calls": {"claim": 1, "check": 0, "done": 0, "read": 0},
                 "tasks": {"task 01 parse": {"name": "task 01 parse", "key": "name:task 01 parse", "paths": ["path:src/parse.py"], "test": "python3 -m unittest tests/test_parse.py", "ask_about": [], "lease_until": "{now+120}", "lease_s": 1800}},
                 "holds": {"name:task 01 parse": {"resource": "task 01 parse", "task": "task 01 parse", "lease_until": "{now+120}", "lease_s": 1800},
                           "path:src/parse.py": {"resource": "task 01 parse", "task": "task 01 parse", "lease_until": "{now+120}", "lease_s": 1800}}}
  },
  "cases": [
    {"name": "row 1: idle, SessionStart with a run id: claim(next=true), the task's name, files, test and ask_about injected", "row": "idle SessionStart run",
     "steps": [{"event": "session-start", "input": {"source": "startup"}, "answers": {"claims": [{"body": "$task1"}]},
                "expect": {"calls": [["POST", "claims", {"next": true, "agent": "agent-1"}]],
                           "context_has": ["your run id is run-m and your agent id is agent-1", "you hold task \"task 01 parse\"", "Its files: src/parse.py", "`python3 -m unittest tests/test_parse.py`", "Ask about these before deciding them yourself: the date format"],
                           "context_not": ["claim(", "done("],
                           "state": {"state": "holding", "tasks": ["task 01 parse"], "holds": ["name:task 01 parse", "path:src/parse.py"], "calls": {"claim": 1}}}}]},
    {"name": "row 1: SubagentStart with a run id: the sub-agent's own machine claims the next task", "row": "idle SubagentStart run",
     "steps": [{"event": "subagent-start", "input": {"agent_id": "sub7", "agent_type": "general-purpose"}, "answers": {"claims": [{"body": "$task2"}]},
                "expect": {"calls": [["POST", "claims", {"next": true, "agent": "agent-1:agent-sub7"}]], "context_has": ["you hold task \"task 02 emit\""],
                           "state_file": "{sid}.sub7", "state": {"state": "holding", "tasks": ["task 02 emit"]}}}]},
    {"name": "row 2: SessionStart with no run id: ids and the peers line only, no claim", "row": "idle SessionStart no run",
     "env": {"CTRLB_RUN": null},
     "steps": [{"event": "session-start", "input": {"source": "startup"},
                "expect": {"calls": [], "context_has": ["your agent id is agent-1", "to the ctrlb tools peers"], "context_not": ["through the plugin's hooks", "you hold task"]}}]},
    {"name": "row 2: SessionStart, no free task: ids, hooks and peers lines, state free", "row": "idle SessionStart none free",
     "steps": [{"event": "session-start", "input": {"source": "startup"}, "answers": {"claims": [{"body": "$none_free"}]},
                "expect": {"calls": [["POST", "claims", {"next": true}]], "context_has": ["through the plugin's hooks", "to the ctrlb tools peers"], "context_not": ["you hold task", "no free task"],
                           "state": {"state": "free", "tasks": [], "holds": []}}}]},
    {"name": "row 2: SubagentStart of a read-only agent type (Explore) claims nothing", "row": "idle SubagentStart read-only",
     "steps": [{"event": "subagent-start", "input": {"agent_id": "sub8", "agent_type": "Explore"},
                "expect": {"calls": [], "context_not": ["you hold task"], "state_file": "{sid}.sub8", "state": {"state": "free", "tasks": []}}}]},
    {"name": "row 3: SessionStart after a compaction, holding: the brief again from the state file, no call", "row": "holding SessionStart compact",
     "state_before": "$holding1",
     "steps": [{"event": "session-start", "input": {"source": "compact"},
                "expect": {"calls": [], "context_has": ["you hold task \"task 01 parse\"", "`python3 -m unittest tests/test_parse.py`"], "state": {"state": "holding", "tasks": ["task 01 parse"], "calls": {"claim": 1}}}}]},
    {"name": "row 4: edit of a file nobody holds: claim(resource=path), no injection", "row": "edit unheld",
     "steps": [{"event": "pre-tool", "input": {"tool_name": "Edit", "file": "src/util.py"},
                "answers": {"check": [{"body": {"mode": "enforce", "allowed": false, "conflicts": [], "own": []}}],
                            "claims": [{"body": {"held": true, "resource": "src/util.py", "key": "path:src/util.py", "token": "tok-u", "lease_until": "{now+1800}"}}]},
                "expect": {"calls": [["POST", "check", {"paths": ["src/util.py"]}], ["POST", "claims", {"resource": "src/util.py", "agent": "agent-1"}]], "decision": null, "context_empty": true,
                           "state": {"state": "holding", "holds": ["path:src/util.py"], "calls": {"check": 1, "claim": 1}}}}]},
    {"name": "row 4: edit with holdRequired unheld conflict: claim(resource=path), the edit goes ahead", "row": "edit unheld (holdRequired)",
     "steps": [{"event": "pre-tool", "input": {"tool_name": "Write", "file": "src/util.py"},
                "answers": {"check": [{"body": {"mode": "enforce", "allowed": false, "own": [], "conflicts": [{"path": "src/util.py", "key": "path:src/util.py", "held_by": "", "lease_until": 0, "reason": "unheld"}]}}],
                            "claims": [{"body": {"held": true, "resource": "src/util.py", "key": "path:src/util.py", "token": "tok-u", "lease_until": "{now+1800}"}}]},
                "expect": {"calls": [["POST", "check", {}], ["POST", "claims", {"resource": "src/util.py"}]], "decision": null, "context_empty": true, "state": {"holds": ["path:src/util.py"]}}}]},
    {"name": "row 4: belongs_to_task: claim that task instead and inject its brief", "row": "edit belongs_to_task",
     "steps": [{"event": "pre-tool", "input": {"tool_name": "Edit", "file": "src/parse.py"},
                "answers": {"check": [{"body": {"mode": "enforce", "allowed": false, "conflicts": [], "own": []}}],
                            "claims": [{"body": {"held": false, "resource": "src/parse.py", "key": "path:src/parse.py", "reason": "belongs_to_task", "task": "task 01 parse", "message": "src/parse.py belongs to the task"}},
                                       {"body": {"held": true, "resource": "task 01 parse", "key": "name:task 01 parse", "paths": ["path:src/parse.py"], "token": "tok-1", "lease_until": "{now+1800}", "test": "python3 -m unittest tests/test_parse.py"}}]},
                "expect": {"calls": [["POST", "check", {}], ["POST", "claims", {"resource": "src/parse.py"}], ["POST", "claims", {"resource": "task 01 parse"}]], "decision": null,
                           "context_has": ["you hold task \"task 01 parse\"", "`python3 -m unittest tests/test_parse.py`"],
                           "state": {"state": "holding", "tasks": ["task 01 parse"], "holds": ["name:task 01 parse", "path:src/parse.py"]}}}]},
    {"name": "row 5: edit of a file the agent holds through its task, far from the lease end: no claim, nothing said", "row": "edit own",
     "state_before": "$holding1",
     "steps": [{"event": "pre-tool", "input": {"tool_name": "Edit", "file": "src/parse.py"},
                "answers": {"check": [{"body": {"mode": "enforce", "allowed": true, "conflicts": [], "own": [{"path": "src/parse.py", "key": "path:src/parse.py", "lease_until": "{now+1700}", "lease_s": 1800}]}}]},
                "expect": {"calls": [["POST", "check", {}]], "decision": null, "context_empty": true, "state": {"calls": {"claim": 1, "check": 1}}}}]},
    {"name": "row 6: edit of a file another agent holds, advisory: inject who holds it", "row": "edit other advisory",
     "steps": [{"event": "pre-tool", "input": {"tool_name": "Edit", "file": "src/emit.py"},
                "answers": {"check": [{"body": {"mode": "advisory", "allowed": true, "own": [], "conflicts": [{"path": "src/emit.py", "key": "path:src/emit.py", "held_by": "agent-2", "lease_until": "{now+900}", "reason": "held"}]}}]},
                "expect": {"calls": [["POST", "check", {}]], "decision": null, "context_has": ["src/emit.py is claimed by agent-2", "leave it to agent-2"], "context_not": ["claim("]}}]},
    {"name": "row 6: edit of a file another agent holds, enforce: deny naming the holder", "row": "edit other enforce",
     "steps": [{"event": "pre-tool", "input": {"tool_name": "Edit", "file": "src/emit.py"},
                "answers": {"check": [{"body": {"mode": "enforce", "allowed": false, "own": [], "conflicts": [{"path": "src/emit.py", "key": "path:src/emit.py", "held_by": "agent-2", "lease_until": "{now+900}", "reason": "held"}]}}]},
                "expect": {"calls": [["POST", "check", {}]], "decision": "deny", "context_has": ["src/emit.py is claimed by agent-2", "Do not edit it", "ask(to=\"agent-2\""], "context_not": ["claim("]}}]},
    {"name": "row 6: a claim on write refused because another agent got the task first, enforce: deny naming it", "row": "edit race lost",
     "steps": [{"event": "pre-tool", "input": {"tool_name": "Edit", "file": "src/parse.py"},
                "answers": {"check": [{"body": {"mode": "enforce", "allowed": false, "conflicts": [], "own": []}}],
                            "claims": [{"body": {"held": false, "resource": "src/parse.py", "reason": "belongs_to_task", "task": "task 01 parse"}},
                                       {"body": {"held": false, "resource": "task 01 parse", "key": "name:task 01 parse", "held_by": "agent-3"}}]},
                "expect": {"calls": [["POST", "check", {}], ["POST", "claims", {"resource": "src/parse.py"}], ["POST", "claims", {"resource": "task 01 parse"}]], "decision": "deny",
                           "context_has": ["src/parse.py belongs to task \"task 01 parse\", held by agent-3"], "state": {"tasks": []}}}]},
    {"name": "row 7: edit of a held task's file within 20% of the lease end: claim the task again (renew), nothing said", "row": "edit renew",
     "state_before": "$holding1_near",
     "steps": [{"event": "pre-tool", "input": {"tool_name": "Edit", "file": "src/parse.py"},
                "answers": {"check": [{"body": {"mode": "enforce", "allowed": true, "conflicts": [], "own": [{"path": "src/parse.py", "key": "path:src/parse.py", "lease_until": "{now+120}", "lease_s": 1800}]}}],
                            "claims": [{"body": {"held": true, "renewed": true, "resource": "task 01 parse", "key": "name:task 01 parse", "paths": ["path:src/parse.py"], "token": "tok-1b", "lease_until": "{now+1800}", "test": "python3 -m unittest tests/test_parse.py"}}]},
                "expect": {"calls": [["POST", "check", {}], ["POST", "claims", {"resource": "task 01 parse"}]], "decision": null, "context_empty": true,
                           "state": {"tasks": ["task 01 parse"], "calls": {"claim": 2, "check": 1}}, "lease_after": {"task 01 parse": 1700}}}]},
    {"name": "row 8: Bash runs the task's test, exit 0: done with witnessed evidence and next=true, the next task's brief injected", "row": "bash test pass",
     "state_before": "$holding1",
     "steps": [{"event": "post-tool", "input": {"tool_name": "Bash", "command": "cd /w && python3 -m unittest tests/test_parse.py", "stdout": "...\n----\nRan 3 tests in 0.01s\n\nOK\n"},
                "answers": {"done": [{"body": {"done": true, "resource": "task 01 parse", "key": "name:task 01 parse", "paths": ["path:src/parse.py"], "next": "$task2"}}]},
                "expect": {"calls": [["POST", "done", {"resource": "task 01 parse", "witnessed": true, "next": true, "evidence": {"command": "cd /w && python3 -m unittest tests/test_parse.py", "exit_code": 0, "summary": "OK"}}]],
                           "context_has": ["task \"task 01 parse\" is finished", "Next: CtrlB Relay: you hold task \"task 02 emit\"", "`python3 -m unittest tests/test_emit.py`"],
                           "state": {"state": "holding", "tasks": ["task 02 emit"], "holds": ["name:task 02 emit", "path:src/emit.py"], "calls": {"done": 1}}}}]},
    {"name": "row 8: the last task done, no next one: said so, state free", "row": "bash test pass, none next",
     "state_before": "$holding1",
     "steps": [{"event": "post-tool", "input": {"tool_name": "Bash", "command": "python3 -m unittest tests/test_parse.py", "stdout": "OK\n"},
                "answers": {"done": [{"body": {"done": true, "resource": "task 01 parse", "key": "name:task 01 parse", "next": "$none_free"}}]},
                "expect": {"calls": [["POST", "done", {"resource": "task 01 parse"}]], "context_has": ["No other task is free in this run"], "state": {"state": "free", "tasks": [], "holds": []}}}]},
    {"name": "row 8: the test fails (PostToolUseFailure, exit 1): no done", "row": "bash test fail",
     "state_before": "$holding1",
     "steps": [{"event": "post-tool-failure", "input": {"tool_name": "Bash", "command": "python3 -m unittest tests/test_parse.py", "error": "Exit code 1\nFAILED (failures=1)"},
                "expect": {"calls": [], "context_empty": true, "state": {"tasks": ["task 01 parse"], "calls": {"done": 0}}}}]},
    {"name": "row 8: a Bash command that is not the registered test, exit 0: no done", "row": "bash other command",
     "state_before": "$holding1",
     "steps": [{"event": "post-tool", "input": {"tool_name": "Bash", "command": "python3 -m unittest discover", "stdout": "OK\n"},
                "expect": {"calls": [], "context_empty": true, "state": {"tasks": ["task 01 parse"]}}}]},
    {"name": "row 9: a done that fails (500) is kept, and sent again on the next Bash event", "row": "done retry",
     "state_before": "$holding1",
     "steps": [{"event": "post-tool", "input": {"tool_name": "Bash", "command": "python3 -m unittest tests/test_parse.py", "stdout": "OK\n"},
                "answers": {"done": [{"status": 500, "body": {"error": "lake unavailable"}}]},
                "expect": {"calls": [["POST", "done", {"resource": "task 01 parse"}]], "context_empty": true, "state": {"tasks": ["task 01 parse"], "pending_done": {"task": "task 01 parse"}}}},
               {"event": "post-tool", "input": {"tool_name": "Bash", "command": "ls", "stdout": "src\n"},
                "answers": {"done": [{"body": {"done": true, "resource": "task 01 parse", "key": "name:task 01 parse", "next": "$none_free"}}]},
                "expect": {"calls": [["POST", "done", {"resource": "task 01 parse", "evidence": {"command": "python3 -m unittest tests/test_parse.py", "exit_code": 0}}]],
                           "context_has": ["task \"task 01 parse\" is finished"], "state": {"state": "free", "tasks": [], "pending_done": null, "calls": {"done": 2}}}}]},
    {"name": "row 8: a done Seeker refuses is not sent again; its message is injected", "row": "done refused",
     "state_before": "$holding1",
     "steps": [{"event": "post-tool", "input": {"tool_name": "Bash", "command": "python3 -m unittest tests/test_parse.py", "stdout": "OK\n"},
                "answers": {"done": [{"body": {"done": false, "resource": "task 01 parse", "reason": "not_holder", "message": "agent-3 took it over"}}]},
                "expect": {"calls": [["POST", "done", {}]], "context_has": ["was not marked finished: agent-3 took it over"], "state": {"pending_done": null}}}]},
    {"name": "row 11: SessionEnd: the open handoff, the machine ends", "row": "session end",
     "state_before": "$holding1",
     "steps": [{"event": "session-end", "input": {"reason": "other"}, "answers": {"handoffs": [{"body": {"handed": true, "open": true, "released": ["name:task 01 parse", "path:src/parse.py"]}}]},
                "expect": {"calls": [["POST", "handoffs", {"all": true, "to": ""}]], "state": {"state": "ended", "tasks": [], "holds": []}}}]},
    {"name": "row 12: ended, SessionStart: as idle (claim next)", "row": "ended SessionStart",
     "state_before": {"agent": "agent-1", "run": "run-m", "state": "ended", "tasks": {}, "holds": {}, "pending_done": null, "calls": {"claim": 3, "check": 0, "done": 1, "read": 0}},
     "steps": [{"event": "session-start", "input": {"source": "resume"}, "answers": {"claims": [{"body": "$task1"}]},
                "expect": {"calls": [["POST", "claims", {"next": true}]], "context_has": ["you hold task \"task 01 parse\""], "state": {"state": "holding", "calls": {"claim": 1}}}}]},
    {"name": "failure: claim on write does not answer in time, advisory: the edit goes ahead", "row": "claim timeout advisory",
     "steps": [{"event": "pre-tool", "input": {"tool_name": "Edit", "file": "src/util.py"},
                "answers": {"check": [{"body": {"mode": "advisory", "allowed": true, "conflicts": [], "own": []}}], "claims": [{"sleep": 3.5, "body": {"held": true}}]},
                "expect": {"calls": [["POST", "check", {}], ["POST", "claims", {"resource": "src/util.py"}]], "decision": null, "context_has": ["Relay did not answer in time, so src/util.py could not be held for you."], "max_s": 4.9}}]},
    {"name": "failure: claim on write does not answer in time, enforce: denied", "row": "claim timeout enforce",
     "steps": [{"event": "pre-tool", "input": {"tool_name": "Edit", "file": "src/util.py"},
                "answers": {"check": [{"body": {"mode": "enforce", "allowed": false, "conflicts": [], "own": []}}], "claims": [{"sleep": 3.5, "body": {"held": true}}]},
                "expect": {"calls": [["POST", "check", {}], ["POST", "claims", {"resource": "src/util.py"}]], "decision": "deny", "context_has": ["the edit was not made. Try the edit again."], "max_s": 4.9}}]},
    {"name": "failure: the edit check itself fails: the edit goes ahead with nothing said, no claim", "row": "check error",
     "steps": [{"event": "pre-tool", "input": {"tool_name": "Edit", "file": "src/util.py"}, "answers": {"check": [{"status": 500, "body": {"error": "boom"}}]},
                "expect": {"calls": [["POST", "check", {}]], "decision": null, "context_empty": true}}]},
    {"name": "failure: a Seeker whose check has no own field: no claim on write without a conflict that says unheld", "row": "check without own",
     "steps": [{"event": "pre-tool", "input": {"tool_name": "Edit", "file": "src/util.py"}, "answers": {"check": [{"body": {"mode": "enforce", "allowed": true, "conflicts": []}}]},
                "expect": {"calls": [["POST", "check", {}]], "decision": null, "context_empty": true}}]},
    {"name": "mode off (CTRLB_ENFORCE=off): no check, no claim on write", "row": "enforce off",
     "env": {"CTRLB_ENFORCE": "off"},
     "steps": [{"event": "pre-tool", "input": {"tool_name": "Edit", "file": "src/util.py"}, "expect": {"calls": [], "decision": null, "context_empty": true}}]},
    {"name": "codex row 1: SessionStart with a run id claims the next task", "row": "codex idle SessionStart", "harness": "codex",
     "steps": [{"event": "session-start", "input": {"source": "startup"}, "answers": {"claims": [{"body": "$task1"}]},
                "expect": {"calls": [["POST", "claims", {"next": true}]], "context_has": ["you hold task \"task 01 parse\""], "state": {"state": "holding", "tasks": ["task 01 parse"]}}}]},
    {"name": "codex row 4: a patch of a file nobody holds: claim on write; in a sub-agent, the sub-agent's machine", "row": "codex edit unheld", "harness": "codex",
     "steps": [{"event": "pre-tool", "input": {"tool_name": "apply_patch", "file": "src/util.py", "agent_id": "csub1"},
                "answers": {"check": [{"body": {"mode": "enforce", "allowed": false, "conflicts": [], "own": []}}],
                            "claims": [{"body": {"held": true, "resource": "src/util.py", "key": "path:src/util.py", "lease_until": "{now+1800}"}}]},
                "expect": {"calls": [["POST", "check", {"agent": "agent-1:csub1"}], ["POST", "claims", {"resource": "src/util.py", "agent": "agent-1:csub1"}]], "decision": null,
                           "state_file": "csub1", "state": {"holds": ["path:src/util.py"]}}}]},
    {"name": "codex row 8: PostToolUse on Bash (Codex's shell result text), the test passes: done, next brief", "row": "codex bash test pass", "harness": "codex",
     "state_before": "$holding1",
     "steps": [{"event": "post-tool", "input": {"tool_name": "Bash", "command": "python3 -m unittest tests/test_parse.py", "tool_response": "Exit code: 0\nWall time: 0.2 seconds\nOutput:\nRan 3 tests in 0.010s\n\nOK\n"},
                "answers": {"done": [{"body": {"done": true, "resource": "task 01 parse", "key": "name:task 01 parse", "next": "$task2"}}]},
                "expect": {"calls": [["POST", "done", {"resource": "task 01 parse", "witnessed": true, "next": true, "evidence": {"exit_code": 0, "summary": "OK"}}]],
                           "context_has": ["you hold task \"task 02 emit\""], "state": {"tasks": ["task 02 emit"], "post_seen": true}}}]},
    {"name": "codex: no PostToolUse reached the session; the Stop hook reads the rollout's passing test and sends done", "row": "codex stop fallback", "harness": "codex",
     "state_before": "$holding1",
     "steps": [{"event": "upload", "input": {"rollout": [["function_call", "c1", {"cmd": "python3 -m unittest tests/test_parse.py"}], ["function_call_output", "c1", "Exit code: 0\nOutput:\nOK\n"]]},
                "answers": {"done": [{"body": {"done": true, "resource": "task 01 parse", "key": "name:task 01 parse", "next": "$none_free"}}]},
                "expect": {"calls": [["POST", "done", {"resource": "task 01 parse", "witnessed": true, "evidence": {"exit_code": 0, "summary": "OK"}}]], "state": {"state": "free", "tasks": []}}}]}
  ]
}
